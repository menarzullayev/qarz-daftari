# Qarz Daftari environment file. Copy to `.env` and fill in. Never commit `.env`.
#
# Two groups:
#   [used now]  read by code that exists today
#   [planned]   named in docs/08-technical-spec and needed by upcoming stories; the names below are the
#               ones the code will read when those stories land. Filling them early is harmless.
#
# Values that are deliberately NOT here because they live in the database and are changed in the admin
# panel (ADR-018): subscription price, receiving card number, trial switch and length, SMS and
# online-payment switches, the receipt review group.
# Also not here: the backup encryption private key, which must stay off the servers (ADR-015).

# --- Environment ---------------------------------------------------------------------------------------
# [planned] development | staging | production
QD_ENV=development

# --- Database ------------------------------------------------------------------------------------------
# [used now] Application role. Cannot bypass row-level security and cannot change ledger entries.
# Local: after `docker compose -f docker-compose.dev.yml up -d` and running the migrations, give the role
# a login once:  ALTER ROLE qd_app LOGIN PASSWORD '<password>';
QD_DATABASE_URL=postgresql://qd_app:CHANGE_ME@127.0.0.1:54329/qarz

# [used now] Owner role, used only to run migrations. Never given to the running application.
QD_MIGRATION_URL=postgresql://postgres:postgres@127.0.0.1:54329/qarz

# [used now] Tests only: a superuser on a throwaway server. The suite creates and drops its own database.
QD_TEST_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres

# --- Telegram (S1.4, S2.1) -----------------------------------------------------------------------------
# [planned] Token from @BotFather for the bot of THIS environment. Use a separate bot per environment.
QD_BOT_TOKEN=
# [planned] The bot's username without @, used to build deep links and QR codes.
QD_BOT_USERNAME=
# [planned] Secret sent by Telegram in the X-Telegram-Bot-Api-Secret-Token header. 1-256 characters,
# A-Z a-z 0-9 _ - only.  Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
QD_WEBHOOK_SECRET=
# [planned] Public HTTPS origin of this environment, no trailing slash. Webhook, Mini App, and Telegram
# Login all require HTTPS; for local work use a tunnel.
QD_PUBLIC_BASE_URL=https://example.invalid
# [optional] API rate limits for signed-in callers: a steady rate per minute and the burst allowed above
# it, per user and per shop. The defaults are shown; limits by network address belong to the proxy.
QD_RATE_USER_PER_MINUTE=120
QD_RATE_USER_BURST=60
QD_RATE_SHOP_PER_MINUTE=600
QD_RATE_SHOP_BURST=200
# [planned] Tests only: token of a second bot used by automated tests, never the development bot.
QD_TEST_BOT_TOKEN=

# --- Security ------------------------------------------------------------------------------------------
# [planned] Key that encrypts secrets stored in the database (administrator second-factor secrets).
# 32 random bytes, base64.  Generate:  python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Losing it locks administrators out; changing it requires re-enrolling their second factor.
QD_SECRETS_KEY=
# [planned] Comma-separated numeric Telegram user IDs allowed to sign in to the admin panel (ADR-017).
QD_ADMIN_TG_IDS=
# [planned] Numeric Telegram chat ID that receives operator alerts and the daily digest.
QD_OPERATOR_CHAT_ID=

# --- File store (S10.2, S14.1, S17.2; ADR-020) ----------------------------------------------------------
# [planned] S3-compatible store hosted on the service's own servers in Uzbekistan.
QD_S3_ENDPOINT=http://127.0.0.1:9000
QD_S3_BUCKET=qarz-files
QD_S3_ACCESS_KEY=
QD_S3_SECRET_KEY=

# --- Switched-off integrations (M5, M7) -----------------------------------------------------------------
# [planned] Leave empty until a registered entity and provider contracts exist. The platform switches for
# SMS and online payment stay off regardless of what is set here.
QD_SMS_PROVIDER=
QD_SMS_API_KEY=
QD_CLICK_SERVICE_ID=
QD_CLICK_SECRET_KEY=
QD_PAYME_MERCHANT_ID=
QD_PAYME_SECRET_KEY=
