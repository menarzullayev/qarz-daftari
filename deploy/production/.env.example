# Settings of the production stack (deploy/production/compose.yml). Copy to a file OUTSIDE the
# repository, readable by the deploying user only, and fill it in:
#
#     install -m 600 deploy/production/.env.example /etc/qarz/production.env
#
# Every name a service reads is listed here, grouped by the service that is given it; compose.yml hands
# each service only its own group. What each value means, and how to generate the secrets, is in the
# root .env.example. backend/tests/test_deploy_files.py fails when a setting the application reads is
# missing from this file or is not handed to the service that reads it.
#
# Compose reads this file itself: write a value that contains "$" inside single quotes, or the "$" is
# taken for a variable.

# --- The deployment itself (read by compose and the scripts, given to no service) -----------------------
# Host directory with fullchain.pem and privkey.pem, readable by user 101 (the proxy's user).
DEPLOY_TLS_DIR=
# Host directory where the certificate client writes ACME challenge files.
DEPLOY_ACME_DIR=
# Address and ports the proxy is published on. Empty: every address, 80 and 443.
DEPLOY_BIND=
DEPLOY_HTTP_PORT=
DEPLOY_HTTPS_PORT=
# Image names without a tag; the tag is always the commit. Set both to a registry path once a registry
# exists, and DEPLOY_PULL=1 to pull instead of building on this host.
DEPLOY_BACKEND_IMAGE=
DEPLOY_PROXY_IMAGE=
DEPLOY_PULL=

# --- proxy image, at build time (public: it is part of the shipped pages) ------------------------------
# The bot's username without @ (the root file calls it QD_BOT_USERNAME).
VITE_BOT_USERNAME=

# --- migrate ---------------------------------------------------------------------------------------------
# The owner connection. Given to the migration only, never to the API or the worker.
QD_MIGRATION_URL=

# --- api and worker --------------------------------------------------------------------------------------
QD_DATABASE_URL=
QD_BOT_TOKEN=
QD_FILE_STORE=
QD_FILE_ROOT=
QD_S3_ENDPOINT=
QD_S3_BUCKET=
QD_S3_REGION=
QD_S3_ACCESS_KEY=
QD_S3_SECRET_KEY=

# --- api only --------------------------------------------------------------------------------------------
QD_WEBHOOK_SECRET=
QD_SECRETS_KEY=
# Only during a rotation of QD_SECRETS_KEY (runbook 4): the secret being replaced. Empty otherwise.
QD_SECRETS_KEY_PREVIOUS=
QD_ADMIN_TG_IDS=
QD_METRICS_TOKEN=
QD_RATE_USER_PER_MINUTE=
QD_RATE_USER_BURST=
QD_RATE_SHOP_PER_MINUTE=
QD_RATE_SHOP_BURST=
QD_STATEMENT_TIMEOUT_MS=
QD_PAYME_MERCHANT_ID=
QD_PAYME_SECRET_KEY=
QD_CLICK_SERVICE_ID=
QD_CLICK_MERCHANT_ID=
QD_CLICK_SECRET_KEY=

# --- worker only -----------------------------------------------------------------------------------------
QD_WORKER_STATEMENT_TIMEOUT_MS=
