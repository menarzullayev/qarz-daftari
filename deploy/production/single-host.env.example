# Settings of the single-host deployment (compose.yml + compose.single-host.yml), in addition to the
# names of .env.example in this directory. `scripts/single-host.sh env-init` writes a file with every
# name below and generated values where a value can be generated; SINGLE-HOST.md says where the others
# come from. The file lives OUTSIDE the repository (default ~/.qarz/single-host.env), readable by its
# owner only. backend/tests/test_single_host_files.py fails when compose.single-host.yml asks for a name
# that is in neither example.
#
# Not used on the single host, and left out of its env file: DEPLOY_TLS_DIR, DEPLOY_ACME_DIR,
# DEPLOY_BIND, DEPLOY_HTTP_PORT, DEPLOY_HTTPS_PORT (the proxy publishes no port and holds no
# certificate), QD_FILE_STORE, QD_FILE_ROOT and QD_S3_* (the files are kept in a volume of this
# machine; compose.single-host.yml sets the first two itself).

# --- The public name ---------------------------------------------------------------------------------------
# The host name people open, without a scheme: the subdomain routed to the tunnel in Cloudflare.
# Read by the scripts (single-host.sh smoke), not by any service.
DEPLOY_PUBLIC_HOST=

# --- cloudflared ---------------------------------------------------------------------------------------------
# The token of the named tunnel (Cloudflare Zero Trust, Networks, Tunnels). Whoever holds it can run the
# tunnel and receive the service's traffic. Given to the `cloudflared` service only.
CLOUDFLARE_TUNNEL_TOKEN=
# auto (QUIC, falling back to HTTP/2) or http2. Empty: auto.
DEPLOY_TUNNEL_PROTOCOL=
# The first three numbers of the private range shared by the tunnel and the proxy; the tunnel is at
# <prefix>.2. Empty: 10.99.240. Change it only when another Docker network of this machine has the range.
DEPLOY_TUNNEL_PREFIX=

# --- db, backup, files-backup: the bucket and the passphrase ---------------------------------------------------
# The S3 endpoint of the Cloudflare account, host name only: <account id>.r2.cloudflarestorage.com
DEPLOY_R2_ENDPOINT=
# The bucket. Everything of this service is under two prefixes in it: pgbackrest/ and crypt/.
DEPLOY_R2_BUCKET=
# Empty: auto, which is what R2 signs with.
DEPLOY_R2_REGION=
# An R2 API token limited to that one bucket, "Object Read & Write": its access key id and its secret.
DEPLOY_R2_ACCESS_KEY_ID=
DEPLOY_R2_SECRET_ACCESS_KEY=
# The passphrase everything is encrypted with on this machine before it is sent to the bucket: the
# database backups and WAL (pgBackRest, AES-256), the stored files and the monthly dumps (rclone crypt).
# Keep it in two places that are NOT this machine. Without it nobody can read the bucket, you included.
# It cannot be changed for what is already there (runbook 4, "The backup key").
DEPLOY_BACKUP_PASSPHRASE=

# --- The schedule (optional) --------------------------------------------------------------------------------
# Seconds between two checks of the repository's freshness. Empty: 300.
DEPLOY_BACKUP_CHECK_INTERVAL=
# Seconds between two copies of the stored files to the bucket. Empty: 300.
DEPLOY_FILES_INTERVAL=

# --- The database image (optional) ----------------------------------------------------------------------------
# Image name without a tag, as DEPLOY_BACKEND_IMAGE in .env.example. Empty: qarz-daftari/pgbackup.
DEPLOY_PGBACKUP_IMAGE=
