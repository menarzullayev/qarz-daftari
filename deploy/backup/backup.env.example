# Settings of the backup scripts. Copy to /etc/qarz-backup/backup.env (owner root, mode 0644).
# Read by the systemd units (EnvironmentFile) and by the scripts when they are started by hand.
# Format: NAME=value, no quotes, no expansion. There are no secrets in this file.

# pgBackRest stanza and the application's database.
QD_STANZA=qarz
QD_DATABASE=qarz
QD_PGUSER=postgres

# The repository directory on this host (repo1-path of pgbackrest.conf).
QD_REPO_PATH=/var/lib/pgbackrest

# Where the monthly dumps, the file store archives and the restore test's marker are kept.
# Put it on the same disk as the repository: it is part of the backup.
QD_STATE_DIR=/var/lib/qarz-backup

# The directory node_exporter's textfile collector reads (--collector.textfile.directory).
QD_TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector

# How the scripts reach the database this host serves (the replica on the standby). Empty: the
# default Unix socket.
QD_SOURCE_PSQL_ARGS=

# The restore test.
QD_RESTORE_TEST_DIR=/var/tmp
QD_MIGRATIONS_DIR=/srv/qarz-daftari/backend/migrations/versions
QD_ROWCOUNT_TABLES=shop membership customer ledger_entry

# The file store: rclone remotes, defined in /etc/qarz-backup/rclone.conf (owner postgres, mode 0600).
QD_FILES_SOURCE=primary:qd-files
QD_FILES_MIRROR=standby:qd-files
QD_FILES_MAX_DELETE=100

# Thresholds of check.sh, in seconds. The first is the operations document's; the others are 26 hours
# and 8 days.
QD_MAX_WAL_AGE_SECONDS=300
QD_MAX_BACKUP_AGE_SECONDS=93600
QD_MAX_FULL_AGE_SECONDS=691200
