# Runs on the standby server. Output goes to the journal: journalctl -u qd-filestore-sync.service
[Unit]
Description=Qarz Daftari: copy the file store's bucket to the standby
Documentation=https://github.com/menarzullayev/qarz-daftari/blob/main/deploy/backup/README.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=-/etc/qarz-backup/backup.env
ExecStart=/opt/qarz-backup/scripts/filestore-sync.sh sync
SyslogIdentifier=qd-filestore-sync
StandardOutput=journal
StandardError=journal
TimeoutStartSec=30min
NoNewPrivileges=yes
ProtectHome=yes
