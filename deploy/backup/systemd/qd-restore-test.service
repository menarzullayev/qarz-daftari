# Runs on the standby server. Output goes to the journal: journalctl -u qd-restore-test.service
[Unit]
Description=qarz: weekly restore test of the latest backup
Documentation=https://github.com/menarzullayev/qarz-daftari/blob/main/deploy/backup/README.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=-/etc/qarz-backup/backup.env
ExecStart=/opt/qarz-backup/scripts/restore-test.sh
SyslogIdentifier=qd-restore-test
StandardOutput=journal
StandardError=journal
TimeoutStartSec=6h
NoNewPrivileges=yes
ProtectHome=yes
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
